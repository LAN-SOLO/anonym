{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "anonym",
  "version": "0.1.0",
  "identifier": "com.lan-solo.anonym",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1435",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "anonym",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0b1220"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVERTg2QzBGNjVFNTQ2QjkKUldTNVJ1VmxEMnpvWFRUSmQrR2MvdVcxS1Azc2J2ZVFZVmZPR3htaEFaZkJoL1V3U29ZUEM1WUcK",
      "endpoints": [
        "https://github.com/LAN-SOLO/anonym/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Anonymisieren ohne KI — Wörterbücher, Muster, Prüfziffern; lokal, ohne Konto",
    "longDescription": "anonym findet Namen, Adressen, Kontonummern, Geburtsdaten und mehr in Texten und Tabellen und ersetzt sie durch stimmige Platzhalter, ohne Satzbau, Spalten oder Formatierung anzurühren. Regelbasiert statt KI: Wörterbücher, Muster und Prüfziffern, deterministisch und offline. Liest und schreibt Text, CSV, DOCX, XLSX und ODF im Ursprungsformat. Kein Konto, keine Telemetrie.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
